# Copy this file to .env in the repository root and fill in the values. .env is ignored by git.
# The keys are read from the environment only; never put a key in a script.

# Needed for classify, baseline, model-selection and demo (they call a language model through OpenRouter)
OPENROUTER_API_KEY=
NCBI_EMAIL=

# Optional: raises the NCBI limit from 3 to 10 requests per second
NCBI_API_KEY=

# Model and prices (USD per million tokens; used only for the cost columns)
MODEL_NAME=openai/gpt-4o
INPUT_TOKEN_COST_PER_MILLION=2.5
OUTPUT_TOKEN_COST_PER_MILLION=10

# Agent settings
MAX_WORKERS=9
RUN_VERSION=run1
# Folder of the HPO record index (docs.faiss, bm25.pkl, documents.pkl); run.py --index sets it too
HPO_INDEX_PATH=
